{
    "main_args": {
        "algo": "haddpg",
        "env": "lima_transporte",
        "exp_name": "madrl_lima_2026",
        "load_config": ""
    },
    "algo_args": {
        "seed": {
            "seed": 42,
            "seed_specify": true
        },
        "device": {
            "cuda": false,
            "cuda_deterministic": true,
            "torch_threads": 4
        },
        "model": {
            "hidden_sizes": [256, 128],
            "activation_func": "relu",
            "final_activation_func": "tanh",
            "lr": 3e-4,
            "critic_lr": 1e-3
        },
        "algo": {
            "share_param": false,
            "fixed_order": true,
            "gamma": 0.99,
            "buffer_size": 100000,
            "batch_size": 256,
            "polyak": 0.005,
            "expl_noise": 0.2,
            "n_step": 3
        },
        "train": {
            "n_rollout_threads": 1,
            "num_env_steps": 336000,
            "warmup_steps": 500,
            "train_interval": 50,
            "update_per_train": 1,
            "log_interval": null,
            "eval_interval": 5000,
            "use_linear_lr_decay": false,
            "use_proper_time_limits": true,
            "model_dir": null
        },
        "eval": {
            "use_eval": false,
            "n_eval_rollout_threads": 1,
            "eval_episodes": 10
        },
        "render": {
            "use_render": false,
            "render_episodes": 5
        },
        "logger": {
            "log_dir": "./results/harl"
        }
    },
    "env_args": {
        "max_steps": 672,
        "data_dir": "data/processed",
        "seed": 42
    }
}
